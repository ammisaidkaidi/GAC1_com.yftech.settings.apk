    <string name="active_safety_aid_item_active_brake">Asistencia de frenado activo</string>
    <string name="active_safety_aid_item_active_brake_describe">Al conducir, si se detecta el riesgo de colisión, se controlará la desaceleración del vehículo</string>
    <string name="active_safety_aid_item_emergency_steering_aid">Asistencia de dirección de emergencia</string>
    <string name="active_safety_aid_item_emergency_steering_aid_describe">Al conducir, el sistema ayuda al conductor a girar si se detecta que el conductor evita chocar con el vehículo delantero a través de la dirección de emergencia</string>
    <string name="active_safety_aid_item_intelligent_speed_limit_control">Control inteligente de límite de velocidad</string>
    <string name="active_safety_aid_item_intelligent_speed_limit_control_describe">Al cruzar, si se identifica la señal de límite de velocidad, se indica si la velocidad de crucero está sincronizada con la de señal</string>
    <string name="active_safety_aid_item_intersection">Asistencia en intersecciones</string>
    <string name="active_safety_aid_item_intersection_describe">Al arrancar, si se detecta un riesgo de llegada lateral por delante se avisará al conductor</string>
    <string name="active_safety_aid_item_lane_departur_sub">"Modo de asistencia de desviación del 
carril"</string>
    <string name="active_safety_aid_item_lane_departure">Asistencia de desviación del carril</string>
    <string name="active_safety_aid_item_lane_departure_describe">Al conducir a alta velocidad, si el conductor se desvía inconscientemente del carril, se emitirá un sonido de alarma o se controlará la dirección para la corrección de asistencia</string>
    <string name="active_safety_aid_item_lane_departure_describe_1">Sonido de alarma si el conductor se desvía del carril inconscientemente al conducir en alta velocidad</string>
    <string name="active_safety_aid_item_lane_keeping">Mantenimiento del carril de emergencia</string>
    <string name="active_safety_aid_item_lane_keeping_describe">Al cambiar de carril, si se detecta un riesgo de colisión con otros vehículos, el sistema corregirá la dirección del vehículo</string>
    <string name="active_safety_aid_item_open_door_warning">Alerta de apertura de puertas</string>
    <string name="active_safety_aid_item_open_door_warning_describe">Al aparcar, la puerta está abierta y si hay riesgo de colisión con el vehículo trasero, se le indicará por voz</string>
    <string name="active_safety_aid_item_pre_collision_warning">Alerta de colisión delantera</string>
    <string name="active_safety_aid_item_pre_collision_warning_describe">Al conducir, si se detecta el riesgo de colisión, se hará una alerta temprana</string>
    <string name="active_safety_aid_item_pre_collision_warning_sub">"Configuración de la distancia 
de alerta de colisión delantera"</string>
    <string name="active_safety_aid_item_prediction">Predicción de puntos ciegos</string>
    <string name="active_safety_aid_item_prediction_describe">Al conducir, si se detecta un riesgo en la zona ciega del cambio de carril, se avisará al conductor en el espejo retrovisor</string>
    <string name="active_safety_aid_item_rear_auto_urgent_braking">Frenado automático de emergencia trasero</string>
    <string name="active_safety_aid_item_rear_auto_urgent_braking_describe">Al dar marcha atrás, si se detecta el riesgo de colisión, se controlará la desaceleración del vehículo</string>
    <string name="active_safety_aid_item_rear_near">Asistencia de aproximación trasera</string>
    <string name="active_safety_aid_item_rear_near_describe">Si el vehículo trasero se acerca demasiado rápido al vehículo y existe el riesgo de colisión, se activará activamente la luz de advertencia de peligro para indicar al vehículo trasero</string>
    <string name="active_safety_aid_item_rear_through">Asistencia para el paso de vehículos traseros</string>
    <string name="active_safety_aid_item_rear_through_describe">Al dar marcha atrás, si se detecta un riesgo de llegada lateral por atrás, se avisará al conductor</string>
    <string name="active_safety_aid_item_speed_limit_sign_recognition">Identificación del límite de velocidad</string>
    <string name="active_safety_aid_item_speed_limit_sign_recognition_describe">Al conducir, si la navegación o la cámara identifica la señal de límite de velocidad, se avisará al conductor a través del instrumento</string>
    <string name="active_safety_aid_item_speed_reminder">"Tips de velocidad 
de seguridad(km/h)"</string>
    <string name="active_safety_aid_item_speed_reminder_describe">Cuando la velocidad del vehículo supera la velocidad establecida, habrá un sonido de alerta</string>
