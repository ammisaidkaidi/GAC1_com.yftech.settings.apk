    <string name="car_lock_item_active_lock">Blocco attivo intelligente</string>
    <string name="car_lock_item_active_lock_describe">Quando le porte sono chiuse, portando la chiave intelligente lontano dal veicolo, le quattro porte vengono bloccate automaticamente.</string>
    <string name="car_lock_item_active_unlocking">Sblocco attivo intelligente</string>
    <string name="car_lock_item_active_unlocking_describe">Quando il veicolo è bloccato, avvicinando la chiave intelligente al veicolo, le quattro porte si sbloccano automaticamente.</string>
    <string name="car_lock_item_auto_unlocking">Sblocco automatico</string>
    <string name="car_lock_item_auto_unlocking_describe">Sblocco automatico del veicolo quando si spegne il motore</string>
    <string name="car_lock_item_auto_window_up_in_rain">Chiusura automatica dei finestrini in caso di pioggia</string>
    <string name="car_lock_item_auto_window_up_lock">"Chiusura automatica dei finestrini quando si chiude l'auto"</string>
    <string name="car_lock_item_auto_window_up_lock_describe">Quando il veicolo viene spento e bloccato, i finestrini e il tettuccio apribile si chiudono automaticamente.</string>
    <string name="car_lock_item_back_door">Apertura del sensore della porta posteriore</string>
    <string name="car_lock_item_back_door_describe">Il veicolo rileva la chiave intelligente e apre automaticamente la porta posteriore.</string>
    <string name="car_lock_item_electric_hidden_door_handle">Maniglie delle porte elettriche nascoste</string>
    <string name="car_lock_item_electric_hidden_door_handle_describe">Quando è chiusa, la maniglia nascosta ad azionamento elettrico viene disattivata e la maniglia della porta deve essere aperta manualmente</string>
    <string name="car_lock_item_key_reminder">Promemoria chiave</string>
    <string name="car_lock_item_key_reminder_describe">"Suona la clason 4 volte per indicare che la chiave è stata lasciata all'interno dell'auto."</string>
    <string name="car_lock_item_lock_carLockPepsAutoTrunkOpen">"1. Spegnere il motore, spegnere il motore e chiudere tutte e quattro le portiere. 
2.Avvicinare la chiave alla porta posteriore entro 0,5 metri e sostarvi per 3 secondi. 
3. La spia del freno alto lampeggia 4 volte e la porta posteriore si apre per induzione. 
Controllare se questa funzione è attivata?"</string>
    <string name="car_lock_item_look_around_open_door">"Rilevamento dell'apertura della porta tramite Panorama"</string>
    <string name="car_lock_item_look_around_open_door_describe">"L'apertura della porta viene rilevata dalla telecamera panoramica e la porta scorrevole si apre automaticamente"</string>
