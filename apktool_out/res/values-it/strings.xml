    <string name="ac_item_aeration">Sblocco della ventilazione attiva</string>
    <string name="ac_item_aeration_describe">"Con questa funzione attivata, il climatizzatore passa automaticamente alla circolazione esterna e al soffiaggio dell'aria dopo lo sblocco della chiave a distanza, realizzando la funzione di ventilazione attiva prima di entrare in auto"</string>
    <string name="ac_item_air_quality_sensor">"Sensore di qualità dell'aria"</string>
    <string name="ac_item_air_quality_sensor_describe">"Controllo del ciclo interno ed esterno e della sensibilità dell'interruttore in base al rilevamento dei gas di scarico"</string>
    <string name="ac_item_atuo_demisting">Disappannamento automatico</string>
    <string name="ac_item_auto_blowing_setting">"Flusso d'aria massimo in modalità automatica"</string>
    <string name="ac_item_auto_blowing_setting_describe">"Quando il climatizzatore è in modalità AUTO, viene impostato il volume dell'aria."</string>
    <string name="ac_item_auto_drying">"Auto-asciugatura dell'aria condizionata"</string>
    <string name="ac_item_auto_drying_describe">"Attivare questa funzione per asciugare automaticamente la superficie dell'evaporatore dopo che il veicolo è stato spento e bloccato per 10 minuti in condizioni di alimentazione sufficiente per evitare umidità e muffa e inibire l'odore di muffa."</string>
    <string name="ac_item_fresh_air_system">Sistema di aria fresca</string>
    <string name="ac_item_fresh_air_system_custom_time">Data personalizzato:</string>
    <string name="ac_item_fresh_air_system_edit">Modifica</string>
    <string name="ac_item_in_out_circulation_control">Controllo intelligente della circolazione interna ed esterna</string>
    <string name="ac_item_in_out_circulation_control_describe">"Commutazione automatica tra circolazione interna ed esterna in base all'ambiente e allo stato del veicolo."</string>
    <string name="ac_item_unlocking_ventilation">Sblocco della ventilazione attiva</string>
    <string name="ac_item_unlocking_ventilation_describe">Attivare questa funzione per ventilare automaticamente il climatizzatore quando il veicolo viene sbloccato</string>
    <string name="ac_title">Aria condizionata</string>
    <string name="active_safety_aid_item_active_brake">Assistenza alla frenata attiva</string>
    <string name="active_safety_aid_item_active_brake_describe">Durante la guida se viene rilevata una collisione imminente, la frenata attiva viene controllata.</string>
    <string name="active_safety_aid_item_emergency_steering_aid">Assistenza allo sterzo di emergenza</string>
    <string name="active_safety_aid_item_emergency_steering_aid_describe">Durante la guida, se il sistema rileva che il conducente evita la collisione con il veicolo che precede con una sterzata di emergenza, il sistema assiste il conducente nella sterzata</string>
    <string name="active_safety_aid_item_intelligent_speed_limit_control">Controllo intelligente del limite di velocità</string>
    <string name="active_safety_aid_item_intelligent_speed_limit_control_describe">Durante la modalità crociera, se il cartello del limite di velocità viene riconosciuto, indica se la velocità di crociera è sincronizzata con il cartello.</string>
    <string name="active_safety_aid_item_intersection">Assistenza agli incroci</string>
    <string name="active_safety_aid_item_intersection_describe">Durante partenza, se viene monitorato il rischio di avvicinamento laterale dei veicoli da fronte, viene emesso un avviso al conducente</string>
    <string name="active_safety_aid_item_lane_departur_sub">Modalita di assistenza al superamento della linea di carreggiata</string>
    <string name="active_safety_aid_item_lane_departure">Assistenza al superamento della linea di carreggiata</string>
    <string name="active_safety_aid_item_lane_departure_describe">"Quando si guida ad alta velocità, se il conducente devia inconsapevolmente dalla corsia, il sistema emette un allarme o controlla l'assistenza allo sterzo per correggere la deviazione."</string>
    <string name="active_safety_aid_item_lane_departure_describe_1">"Quando si guida ad alta velocità, se il conducente devia inconsapevolmente dalla corsia, il sistema emette un allarme o controlla l'assistenza allo sterzo per correggere la deviazione."</string>
    <string name="active_safety_aid_item_lane_keeping">Mantenimento della corsia di emergenza</string>
    <string name="active_safety_aid_item_lane_keeping_describe">Quando si cambia corsia, il sistema corregge lo sterzo del veicolo se rileva il rischio di collisione con altri veicoli.</string>
    <string name="active_safety_aid_item_open_door_warning">Avviso apertura porte</string>
    <string name="active_safety_aid_item_open_door_warning_describe">"In fase di parcheggio, se la porta viene aperta e c'è il rischio di collisione con l'auto retrostante, il conducente e i passeggeri vengono avvisati vocalmente"</string>
    <string name="active_safety_aid_item_pre_collision_warning">Avviso di collisione anteriore</string>
    <string name="active_safety_aid_item_pre_collision_warning_describe">Durante la guida se viene rilevato il rischio di collisione, viene emesso un avviso</string>
    <string name="active_safety_aid_item_pre_collision_warning_sub">Impostazioni della distanza avviso di collisione anteriore</string>
    <string name="active_safety_aid_item_prediction">Monitoraggio della zona cieca</string>
    <string name="active_safety_aid_item_prediction_describe">Durante la guida, se il sistema rileva un rischio di cambio di corsia nella zona cieca, avvisa il conducente nello specchietto retrovisore.</string>
    <string name="active_safety_aid_item_rear_auto_urgent_braking">Frenata di emergenza automatica da posteriore</string>
    <string name="active_safety_aid_item_rear_auto_urgent_braking_describe">Durante la retromarcia se viene rilevato il rischio di collisione, il veicolo rallenta.</string>
    <string name="active_safety_aid_item_rear_near">"Assistenza all'avvicinamento del veicolo posteriore"</string>
    <string name="active_safety_aid_item_rear_near_describe">"Se il veicolo che si avvicina da dietro è troppo veloce e c'è il rischio di collisione, vengono attive le luci di emergenza per avvisare il veicolo dietro."</string>
    <string name="active_safety_aid_item_rear_through">Assistenza al passaggio del veicolo posteriore</string>
    <string name="active_safety_aid_item_rear_through_describe">Durante la retromarcia, se viene monitorato il rischio di avvicinamento laterale dei veicoli da dietro, viene emesso un avviso al conducente</string>
    <string name="active_safety_aid_item_speed_limit_sign_recognition">Riconoscimento dei segnali di limite di velocità</string>
    <string name="active_safety_aid_item_speed_limit_sign_recognition_describe">Durante la guida, se il navigatore o la telecamera riconoscono il cartello del limite di velocità, lo segnalano al conducente attraverso lo strumento.</string>
    <string name="active_safety_aid_item_speed_reminder">Avviso di velocità sicura (km/h)</string>
    <string name="active_safety_aid_item_speed_reminder_describe">Quando la velocità di marcia del veicolo supera la velocità impostata, viene emesso un allarme sonoro per ricordarlo al conducente.</string>
    <string name="active_safety_aid_item_speeding_alarm">Allarme di velocità autovelox</string>
    <string name="active_safety_aid_item_speeding_alarm_describe">Durante la guida, se la velocità supera il limite della velocità, viene emesso un segnale acustico per avvisare il conducente</string>
    <string name="active_safety_aid_item_status_alert">Avviso di stato del conducente</string>
    <string name="active_safety_aid_item_status_alert_describe">Durante la guida, se viene rilevata una stanchezza o una distrazione del conducente, viene emesso un avviso vocale al conducente</string>
