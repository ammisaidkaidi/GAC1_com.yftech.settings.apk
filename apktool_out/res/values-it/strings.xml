    <string name="car_light_item_adaptive">Fari adattivi</string>
    <string name="car_light_item_adaptive_describe">"Accensione automatica parziale o totale degli abbaglianti in base alla velocità del veicolo, all'ambiente del traffico, ecc."</string>
    <string name="car_light_item_high">Fari abbaglianti intelligenti</string>
    <string name="car_light_item_high_describe">"Con il presupposto dell'accensione AUTO dei fari, in base alla velocità, all'ambiente del traffico e ad altre condizioni, commuta automaticamente gli abbaglianti e gli anabbaglianti."</string>
